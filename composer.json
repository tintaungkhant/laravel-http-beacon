{
    "name": "tintaungkhant/laravel-http-beacon",
    "description": "A lightweight Laravel package for logging incoming and outgoing HTTP requests.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "http",
        "logger",
        "monitor",
        "traffic",
        "telescope"
    ],
    "authors": [
        {
            "name": "Tint Aung Khant",
            "email": "aherkersoemin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "HttpBeacon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HttpBeacon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HttpBeacon\\BeaconServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
