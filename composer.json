{
    "name": "tintaungkhant/traffic-monitor",
    "description": "A lightweight Laravel package for logging incoming and outgoing HTTP requests.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "http",
        "logger",
        "monitor",
        "traffic",
        "telescope"
    ],
    "authors": [
        {
            "name": "Tint Aung Khant",
            "email": "aherkersoemin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tintaungkhant\\TrafficMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tintaungkhant\\TrafficMonitor\\TrafficMonitorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
