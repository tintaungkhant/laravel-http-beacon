{
    "name": "tintaungkhant/laravel-http-beacon",
    "description": "A lightweight Laravel package for logging incoming and outgoing HTTP requests.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "http",
        "logger",
        "monitor",
        "traffic",
        "telescope"
    ],
    "authors": [
        {
            "name": "Tint Aung Khant",
            "email": "aherkersoemin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0",
        "phpstan/phpstan": "^1.10|^2.1",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^2.9|^3.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "HttpBeacon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HttpBeacon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HttpBeacon\\BeaconServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
